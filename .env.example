# Browser + server (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: OpenAI-compatible API base (when ai_provider is openai)
MODEL_API_BASE=https://your-provider-endpoint/v1

# Server-only: Gemini (used when ai_provider is gemini or as fallback for keys)
GEMINI_API_KEY=

# Must match vector(N) in document_chunks.embedding (default 3072; run migration 003 after changing)
EMBEDDING_VECTOR_DIMENSIONS=3072

# --- MUDRIK_CORE_OS v7.0 (Ollama hybrid: تحليل + صياغة)
# Used when user_settings.generation_engine = sovereign (default after migration 005).
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
# وضع نموذج واحد: LOCAL_OLLAMA_MODEL=your-tag (يُستخدم للتحليل والصياغة معاً).
# وضع هجين: لا تعيّن LOCAL_OLLAMA_MODEL؛ عيّن التاليين (وسوم بحسب تثبيتك، مثل llama3.1 أو qwen2.5:72b).
# LOCAL_OLLAMA_MODEL=
LOCAL_OLLAMA_MODEL_ANALYSIS=deepseek-r1:latest
# وسوم غير مثبتة تُستبدل تلقائياً بأقرب نموذج متاح (انظر resolveOllamaModelTag في lib/ai-gateway.ts)
LOCAL_OLLAMA_MODEL_SYNTHESIS=llama3.1:70b
# Optional overrides for sampling (defaults: temp 0.1, top_p 0.85, frequency_penalty 1.0, presence_penalty 0.8)
# SOVEREIGN_OLLAMA_TEMPERATURE=0.1
# SOVEREIGN_OLLAMA_TOP_P=0.85
# SOVEREIGN_OLLAMA_FREQUENCY_PENALTY=1.0
# SOVEREIGN_OLLAMA_PRESENCE_PENALTY=0.8
# SOVEREIGN_OLLAMA_TOP_K=30
# SOVEREIGN_OLLAMA_REPEAT_PENALTY=1.05
# Long-form sections (tokens) and HTTP timeout per Ollama request (ms)
LOCAL_OLLAMA_NUM_PREDICT=16384
LOCAL_OLLAMA_TIMEOUT_MS=600000
# If true (default), when Ollama is unreachable, fall back to cloud using ai_provider keys
SOVEREIGN_AUTO_CLOUD_FALLBACK=true

# POST /api/engine/generate: في الإنتاج يُشترط تسجيل الدخول دائماً. في التطوير يمكن فرض ذلك بـ:
# ENGINE_GENERATE_REQUIRE_AUTH=true
